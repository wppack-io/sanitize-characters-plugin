#!/bin/sh
#
# Resets the browser-testing WordPress to a fresh install: drops all tables,
# reinstalls, clears uploads, and reactivates all plugins. Also bootstraps the
# dev-only files under the gitignored web/ on first run. Requires the dev
# database (docker compose up -d mysql).
#
# Usage: [SANITIZE_CHARACTERS_DEV_PORT=8082] bin/dev-reset

set -eu
cd "$(dirname "$0")/.."

PORT="${SANITIZE_CHARACTERS_DEV_PORT:-8082}"
URL="http://localhost:$PORT"

# --- Dev-only files (web/ is gitignored; this script is their canonical source) ---

if [ ! -f web/wp-config.php ]; then
    cat > web/wp-config.php <<'PHP'
<?php

// Dev-only config for browser testing, generated by bin/dev-reset.

// Composer autoloader
require_once dirname(__DIR__) . '/vendor/autoload.php';

if (!defined('ABSPATH')) {
    define('ABSPATH', __DIR__ . '/wp/');
}
// Derive the base URL from the request so the port is not baked in
// (bin/dev-server picks the port; CLI falls back to SANITIZE_CHARACTERS_DEV_PORT).
$devHost = $_SERVER['HTTP_HOST'] ?? ('localhost:' . (getenv('SANITIZE_CHARACTERS_DEV_PORT') ?: '8082'));
define('WP_CONTENT_DIR', __DIR__ . '/wp-content');
define('WP_HOME', "http://{$devHost}");
define('WP_SITEURL', WP_HOME . '/wp');
define('WP_CONTENT_URL', WP_HOME . '/wp-content');

define('DB_NAME', 'sanitize_characters_dev');
define('DB_USER', 'root');
define('DB_PASSWORD', 'password');
define('DB_HOST', '127.0.0.1:3314');
define('DB_CHARSET', 'utf8');
define('DB_COLLATE', '');
$table_prefix = 'wpdev_';

define('WP_DEBUG', true);
define('WP_DEBUG_LOG', true);
define('WP_DEBUG_DISPLAY', false);
define('WP_ENVIRONMENT_TYPE', 'local');
define('AUTOMATIC_UPDATER_DISABLED', true);

// Auth keys (dev only — do not use in production)
define('AUTH_KEY', 'sanitize-characters-dev-auth-key');
define('SECURE_AUTH_KEY', 'sanitize-characters-dev-secure-auth-key');
define('LOGGED_IN_KEY', 'sanitize-characters-dev-logged-in-key');
define('NONCE_KEY', 'sanitize-characters-dev-nonce-key');
define('AUTH_SALT', 'sanitize-characters-dev-auth-salt');
define('SECURE_AUTH_SALT', 'sanitize-characters-dev-secure-auth-salt');
define('LOGGED_IN_SALT', 'sanitize-characters-dev-logged-in-salt');
define('NONCE_SALT', 'sanitize-characters-dev-nonce-salt');

require_once ABSPATH . 'wp-settings.php';
PHP
    echo 'created:  web/wp-config.php'
fi

if [ ! -f web/index.php ]; then
    cat > web/index.php <<'PHP'
<?php

// Dev-only front controller, generated by bin/dev-reset.

define('WP_USE_THEMES', true);
require __DIR__ . '/wp/wp-blog-header.php';
PHP
    echo 'created:  web/index.php'
fi

# A real file, NOT a symlink to the repo root: wp_register_plugin_realpath()
# would map the plugin dir to the repo root — an ancestor of web/ — corrupting
# plugin_basename()/plugins_url() for every plugin under web/wp-content/plugins/.
if [ ! -f web/wp-content/plugins/sanitize-characters/wppack-sanitize-characters.php ]; then
    mkdir -p web/wp-content/plugins/sanitize-characters
    cat > web/wp-content/plugins/sanitize-characters/wppack-sanitize-characters.php <<'PHP'
<?php

/**
 * Plugin Name: WPPack Sanitize Characters
 * Description: Dev stub generated by bin/dev-reset — loads the plugin from the repository root.
 * Version: 1.0.0
 * Requires PHP: 8.2
 * Requires at least: 6.7
 * Author: WPPack
 * License: MIT
 */

declare(strict_types=1);

if (!defined('ABSPATH')) {
    exit;
}

require dirname(__DIR__, 4) . '/wppack-sanitize-characters.php';
PHP
    echo 'created:  web/wp-content/plugins/sanitize-characters/wppack-sanitize-characters.php'
fi

# --- Reset ---

vendor/bin/wp db reset --yes

rm -rf web/wp-content/uploads
mkdir -p web/wp-content/uploads

rm -f web/wp-content/debug.log

vendor/bin/wp core install \
    --url="$URL" \
    --title='Sanitize Characters Dev' \
    --admin_user=admin \
    --admin_password=password \
    --admin_email=admin@example.test \
    --skip-email

vendor/bin/wp plugin activate --all

# Seed content to exercise the plugin against: a clean post (the save filter
# strips on the way in), plus a dirty post and meta injected straight into the
# DB — pre-existing data for `wp sanitize-characters` to find.
vendor/bin/wp post create --post_title='Clean post' --post_status=publish --post_content='Body' >/dev/null
vendor/bin/wp eval '
global $wpdb;
$now = current_time("mysql");
$wpdb->insert($wpdb->posts, [
    "post_title" => "Dirty\u{200B} title with a zero-width space and a\u{0001} control char",
    "post_content" => "\u{FEFF}Body pasted from a word processor",
    "post_excerpt" => "", "post_status" => "publish", "post_type" => "post",
    "post_date" => $now, "post_date_gmt" => $now, "post_modified" => $now, "post_modified_gmt" => $now,
    "to_ping" => "", "pinged" => "", "post_content_filtered" => "",
]);
add_post_meta($wpdb->insert_id, "seeded_meta", "va\u{200B}lue");
echo "seeded dirty post {$wpdb->insert_id}\n";
'

echo
echo "Reset complete: $URL/wp/wp-admin/ (admin / password)"
echo "Server: bin/dev-server"
